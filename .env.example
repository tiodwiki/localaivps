# ============================================================
# Open WebUI + llama.cpp  — konfigurasi (salin ke .env)
#   cp .env.example .env
# ============================================================

# Wajib: kunci API untuk llama-server (Open WebUI memakai ini utk terhubung).
# Bebas isi apa pun, mis. token acak (openssl rand -hex 32).
LLAMA_API_KEY=changeme-super-secret-api-key

# Port Open WebUI diakses dari browser (default 3000)
PORT=3000

# Ukuran konteks (token). 4096 aman utk RAM 12GB di 2-core ARM.
CTX_SIZE=4096

# Jumlah thread CPU utk generasi. VPS ini 2 core -> 2.
THREADS=2